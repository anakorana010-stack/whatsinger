const startAudioRecord = async () => {
setIsRecording(true)
playSound('mic')
playSound('recording')
try {
const stream = await navigator.mediaDevices.getUserMedia({ audio: true })
mediaRecorderRef.current = new MediaRecorder(stream)
audioChunksRef.current = []
mediaRecorderRef.current.ondataavailable = e => audioChunksRef.current.push(e.data)
mediaRecorderRef.current.onstop = async () => {
const blob = new Blob(audioChunksRef.current, { type: 'audio/webm' })
const fileName = `${user?.id || 'guest'}-${Date.now()}.webm`
try{
await supabase.storage.from('voice-messages').upload(fileName, blob)
const { data } = supabase.storage.from('voice-messages').getPublicUrl(fileName)
setMessages(prev => [...prev, { id: Date.now(), text: data.publicUrl, type: 'audio', time: new Date().toLocaleTimeString('ar-EG'), status: 'sent', seen: false }])
} catch(e){ setMessages(prev => [...prev, { id: Date.now(), text: URL.createObjectURL(blob), type: 'audio', time: new Date().toLocaleTimeString('ar-EG'), status: 'sent', seen: false }]) }
playSound('goldDrop')
}
mediaRecorderRef.current.start()
} catch(e) {
alert('مش قادر افتح المايك')
setIsRecording(false)
}
}
const stopAudioRecord = () => {
if(mediaRecorderRef.current && isRecording){
mediaRecorderRef.current.stop()
setIsRecording(false)
try{ mediaRecorderRef.current.stream.getTracks().forEach(track => track.stop()) }catch(e){}
}
}
// ===== useEffect =====
useEffect(() => {
const timer = setInterval(() => {
if(Date.now() - lastActivity > 30000) setIsBored(true)
else setIsBored(false)
}, 5000)
return () => clearInterval(timer)
}, [lastActivity])
useEffect(() => {
const t = setInterval(() => { setGoldBadgeTimer(prev => prev > 0 ? prev - 1 : 0) }, 1000)
return () => clearInterval(t)
}, [])
useEffect(()=>{
if(subscription.endDate){
const now = new Date();
const days = Math.ceil((subscription.endDate - now) / (1000*60*60*24));
setDaysLeft(days > 0 ? days : 0);
if(days <= 10 && days > 0 && subscription.status === 'gold'){ setSubscription(prev => ({...prev, status: 'silver'})); alert('باقي 10 ايام! التاج اصبح فضي 🥈') }
if(days <= 0 && subscription.status !== 'none'){ setSubscription({status: 'none', plan: null, startDate: null, endDate: null}); alert('انتهت الشارة. التاج اصبح فضي 🥈') }
}
}, [subscription])
useEffect(() => {
supabase.auth.getUser().then(({ data }) => {
setUser(data.user)
if(data.user){ setCurrentPage('main'); loadUserData(data.user.id); if(data.user.id === ADMIN_ID) setIsAdmin(true) }
})
}, [])
// ===== s و sKing =====
