const  {  data  } = supabase. storage . from ( 'voice-messages' ) . getPublicUrl ( fileName )
setMessages ( prev => [ ...prev, {
id :Date. now ( ) ,
نص : بيانات. عنوان URL العام ،
النوع : 'صوتى' ،
الوقت : تاريخ جديد ( ) . toLocaleTimeString ( 'ar-EG' )
} ] )
playSound ( 'goldDrop' ) ; // بدل النجاح
}
